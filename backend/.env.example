# Set this to a strong random value before running the real API.
HOOKLEDGER_ADMIN_TOKEN=replace-with-long-random-token
# Optional: when present, all inbound webhooks require X-HookLedger-Signature (sha256=hex HMAC).
HOOKLEDGER_WEBHOOK_SECRET=replace-with-strong-random-webhook-secret
HOOKLEDGER_DB_PATH=./hookledger.db
HOOKLEDGER_CORS_ORIGINS=http://localhost:5173
